#!ipxe

# Provisioning boot menu, dispatched by MAC address.
# Keep the MAC list in sync with hosts.csv.
#
# All three hosts are now Rocky Linux 9 via kickstart (Proxmox path
# dropped entirely - simpler and more reliable than the Proxmox
# auto-installer/USB netboot dance). host2 is commented out below since
# it's already installed - same "retire once done" pattern applies to
# host1/host3 once their installs are confirmed (see README).

set repo_base https://raw.githubusercontent.com/maximepatry/k8s-homelab/main/bare-metal
set rocky_base https://dl.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os

iseq ${mac} 78:55:36:02:de:9e && goto host1 ||
# host2 commented out - already installed, PXE dispatch removed to avoid
# an accidental reinstall loop. Uncomment (and fix its BIOS boot order
# again if needed) to reprovision.
# iseq ${mac} e8:ff:1e:d8:a0:d0 && goto host2 ||
iseq ${mac} 00:16:96:ee:1e:4d && goto host3 ||
goto unknown

:host1
kernel ${rocky_base}/images/pxeboot/vmlinuz inst.ks=${repo_base}/kickstart/ks-host1.cfg inst.repo=${rocky_base} ip=dhcp inst.text
initrd ${rocky_base}/images/pxeboot/initrd.img
boot

:host2
kernel ${rocky_base}/images/pxeboot/vmlinuz inst.ks=${repo_base}/kickstart/ks-host2.cfg inst.repo=${rocky_base} ip=dhcp inst.text
initrd ${rocky_base}/images/pxeboot/initrd.img
boot

:host3
kernel ${rocky_base}/images/pxeboot/vmlinuz inst.ks=${repo_base}/kickstart/ks-host3.cfg inst.repo=${rocky_base} ip=dhcp inst.text
initrd ${rocky_base}/images/pxeboot/initrd.img
boot

:unknown
echo Unrecognized MAC: ${mac}
echo Dropping to iPXE shell.
shell
